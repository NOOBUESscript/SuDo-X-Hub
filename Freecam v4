local function Fr(p, sz, pos, bg, n, r)
    local f = Instance.new("Frame")
    f.Name = n or "f"; f.Size = sz; f.Position = pos
    f.BackgroundColor3 = bg or C.Panel; f.BorderSizePixel = 0; f.Parent = p
    if r then Instance.new("UICorner", f).CornerRadius = UDim.new(0, r) end
    return f
end

local function Lb(p, t, sz, pos, col, fs, bold, xa)
    local l = Instance.new("TextLabel")
    l.Text = t; l.Size = sz; l.Position = pos
    l.BackgroundTransparency = 1
    l.TextColor3    = col or C.Text
    l.Font          = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextSize      = fs or 13
    l.TextXAlignment = xa or Enum.TextXAlignment.Left
    l.Parent = p; return l
end

local function Bt(p, t, sz, pos, bg, tc, r)
    local b = Instance.new("TextButton")
    b.Text = t; b.Size = sz; b.Position = pos
    b.BackgroundColor3 = bg or C.Accent
    b.TextColor3       = tc or C.White
    b.Font             = Enum.Font.GothamBold
    b.TextSize         = 12
    b.BorderSizePixel  = 0
    b.AutoButtonColor  = false
    b.Parent = p
    if r then Instance.new("UICorner", b).CornerRadius = UDim.new(0, r) end
    local origBG = bg or C.Accent
    b.MouseEnter:Connect(function()
        TS:Create(b, TweenInfo.new(0.12), {
            BackgroundColor3 = origBG:Lerp(Color3.new(1,1,1), 0.15)
        }):Play()
    end)
    b.MouseLeave:Connect(function()
        TS:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = origBG}):Play()
    end)
    return b
end

local function Sec(p, txt, y)
