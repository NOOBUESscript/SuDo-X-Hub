    Fr(f, UDim2.new(0,3,0.5,0), UDim2.new(0,0,0.25,0), C.Accent, "bar", 2)
    Lb(f, "   "..txt, UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.Accent, 11, true)
end

local function Sld(p, lbl, mn, mx, def, y, dec, cb)
    dec = dec or 2
    local cont = Fr(p, UDim2.new(1,-16,0,50), UDim2.new(0,8,0,y), C.BG, "SL_"..lbl)
    cont.BackgroundTransparency = 1
    Lb(cont, lbl, UDim2.new(0.62,0,0,18), UDim2.new(0,0,0,0), C.Sub, 11)
    local vl = Lb(cont, tostring(def),
        UDim2.new(0.36,0,0,18), UDim2.new(0.62,0,0,0), C.Accent, 11, true,
        Enum.TextXAlignment.Right)
    local tr = Fr(cont, UDim2.new(1,0,0,8), UDim2.new(0,0,0,26), C.Border, "T", 4)
    local fi = Fr(tr,  UDim2.new((def-mn)/(mx-mn),0,1,0), UDim2.new(0,0,0,0), C.Accent, "F", 4)
    local kn = Fr(tr,  UDim2.new(0,24,0,24), UDim2.new((def-mn)/(mx-mn),-12,0.5,-12), C.Accent,"K",12)
    Instance.new("UIStroke", kn).Thickness = 2

    local function Update(x)
        local rel = math.clamp(
            (x - tr.AbsolutePosition.X) / math.max(tr.AbsoluteSize.X, 1), 0, 1)
        local v = math.floor((mn + rel*(mx-mn))*(10^dec)+0.5)/(10^dec)
        fi.Size     = UDim2.new(rel, 0, 1, 0)
        kn.Position = UDim2.new(rel, -12, 0.5, -12)
        vl.Text     = tostring(v)
        if cb then cb(v) end
    end

    local drag = false
    local function Beg(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; Update(i.Position.X)
        end
    end
    tr.InputBegan:Connect(Beg); kn.InputBegan:Connect(Beg)
    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement then
            Update(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)
end

local function Drag(handle, target)
    local on, ds, ts = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            on = true; ds = i.Position; ts = target.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not on then return end
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - ds
            target.Position = UDim2.new(
                ts.X.Scale, ts.X.Offset + d.X,
                ts.Y.Scale, ts.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            on = false
        end
    end)
end

local function TapConnect(btn, fn)
    btn.MouseButton1Click:Connect(fn)
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then fn() end
    end)
end

