-- ═══════════════════════════════════════════
--  SHADER ENGINE
-- ═══════════════════════════════════════════
local FX    = {}
local MB_C  = nil   -- motion blur connection

local function ClearFX()
    if MB_C then MB_C:Disconnect(); MB_C = nil end
    for _, v in pairs(FX) do
        pcall(function() v:Destroy() end)
    end
    FX = {}
end

local function ResetLighting()
    Lighting.Ambient               = Color3.fromRGB(127,127,127)
    Lighting.Brightness            = 2
    Lighting.ColorShift_Bottom     = Color3.fromRGB(0,0,0)
    Lighting.ColorShift_Top        = Color3.fromRGB(0,0,0)
    Lighting.EnvironmentDiffuseScale  = 1
    Lighting.EnvironmentSpecularScale = 1
    Lighting.GlobalShadows         = true
    Lighting.OutdoorAmbient        = Color3.fromRGB(127,127,127)
    Lighting.ShadowSoftness        = 0.14
    Lighting.ExposureCompensation  = 0
end

local function ApplyShader()
    ClearFX()
    if not S.ShaderEnabled then
        ResetLighting()
        return
    end
    local p = Presets[S.ShaderName]
    if not p then return end

    Lighting.Ambient               = Color3.fromRGB(S.Amb_R, S.Amb_G, S.Amb_B)
    Lighting.Brightness            = S.Br
    Lighting.ColorShift_Bottom     = Color3.fromRGB(0, 0, 0)
    Lighting.ColorShift_Top        = Color3.fromRGB(p.TopR,p.TopG,p.TopB)
    Lighting.EnvironmentDiffuseScale  = p.EnvD
    Lighting.EnvironmentSpecularScale = p.EnvS
    Lighting.GlobalShadows         = true
    Lighting.OutdoorAmbient        = Color3.fromRGB(p.OutR,p.OutG,p.OutB)
    Lighting.ShadowSoftness        = S.Shad
    Lighting.GeographicLatitude    = -15.525
    Lighting.ExposureCompensation  = S.Expo

    local bl = Instance.new("BloomEffect", Lighting)
    bl.Intensity = S.Bloom_I; bl.Size = S.Bloom_S
    bl.Threshold = S.Bloom_T; bl.Enabled = true
    table.insert(FX, bl)

    local cc = Instance.new("ColorCorrectionEffect", Lighting)
    cc.Brightness  = S.CC_Br; cc.Contrast  = S.CC_Co
    cc.Saturation  = S.CC_Sa; cc.Enabled   = true
    cc.TintColor   = Color3.fromRGB(p.TR,p.TG,p.TB)
    table.insert(FX, cc)

    local dof = Instance.new("DepthOfFieldEffect", Lighting)
    dof.FarIntensity  = S.DOF_F; dof.FocusDistance = S.DOF_D
    dof.InFocusRadius = S.DOF_R; dof.NearIntensity = S.DOF_N
    dof.Enabled = true
    table.insert(FX, dof)

    local sr = Instance.new("SunRaysEffect", Lighting)
    sr.Intensity = S.SR_I; sr.Spread = S.SR_Sp; sr.Enabled = true
    table.insert(FX, sr)

    if p.MB then
        local cam = WS.CurrentCamera
        local mb  = Instance.new("BlurEffect", cam)
        table.insert(FX, mb)
        local lv = cam.CFrame.LookVector
        MB_C = Run.Heartbeat:Connect(function()
            if not S.ShaderEnabled or not mb.Parent then
                if MB_C then MB_C:Disconnect(); MB_C = nil end
                return
            end
            local mag = (cam.CFrame.LookVector - lv).Magnitude
            mb.Size   = mag * S.MB_A * S.MB_Amp / 2
            lv        = cam.CFrame.LookVector
        end)
    end
end

