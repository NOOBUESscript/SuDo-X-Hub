--  FREECAM ENGINE
-- ═══════════════════════════════════════════
local FC = {
    Conn     = nil,
    Vel      = Vector3.zero,
    Pitch    = 0,
    Yaw      = 0,
    CamPos   = Vector3.new(0, 10, 0),
    OrigType = Enum.CameraType.Custom,
}

-- JoyLayer declared here so freecam can reference it
-- It will be assigned after GUI is built
local JoyLayer = nil

local function EnableFreecam()
    if S.FreecamActive then return end
    local st = Styles[S.StyleIndex]
    S.Speed = st.V; S.FOV = st.F; S.Smooth = st.M

    local cam = WS.CurrentCamera
    FC.OrigType = cam.CameraType
    cam.CameraType = Enum.CameraType.Scriptable

    FC.CamPos = cam.CFrame.Position
    local _, yaw, _ = cam.CFrame:ToEulerAnglesYXZ()
    FC.Pitch = 0
    FC.Yaw   = math.deg(yaw)

    if not UIS.TouchEnabled then
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    end

    local ch = LP.Character
    if ch then
        local h = ch:FindFirstChild("HumanoidRootPart")
        if h then h.Anchored = true end
    end

    FC.Conn = Run.RenderStepped:Connect(function(dt)
        local cam2 = WS.CurrentCamera
        if not cam2 then return end

        -- Look: mouse (PC)
        if not UIS.TouchEnabled then
            local d = UIS:GetMouseDelta()
            FC.Yaw   = FC.Yaw   - d.X * 0.25
            FC.Pitch = math.clamp(FC.Pitch - d.Y * 0.25, -89, 89)
        end

        -- Look: touch pad (mobile)
        FC.Yaw   = FC.Yaw   + TI.LookX
        FC.Pitch = math.clamp(FC.Pitch + TI.LookY, -89, 89)
        TI.LookX = 0; TI.LookY = 0

        local rot = CFrame.Angles(0, math.rad(FC.Yaw), 0)
                  * CFrame.Angles(math.rad(FC.Pitch), 0, 0)

        -- Move: keyboard
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + rot.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - rot.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - rot.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + rot.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.E) then dir = dir + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then dir = dir - Vector3.new(0,1,0) end

        -- Move: joystick (mobile)
        if math.abs(TI.MoveX) > 0.05 or math.abs(TI.MoveZ) > 0.05 then
            dir = dir + rot.RightVector * TI.MoveX
                      + rot.LookVector  * (-TI.MoveZ)
        end
        if math.abs(TI.MoveY) > 0.05 then
            dir = dir + Vector3.new(0, TI.MoveY, 0)
        end

        local spd = S.Speed
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift)   then spd = spd * 3    end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl)  then spd = spd * 0.25 end

        local target = dir.Magnitude > 0 and dir.Unit * spd or Vector3.zero
        local alpha  = math.clamp(S.Smooth * 60 * dt, 0.01, 1)
        FC.Vel = FC.Vel:Lerp(target, alpha)

        FC.CamPos        = FC.CamPos + FC.Vel * dt
        cam2.CFrame      = CFrame.new(FC.CamPos) * rot
        cam2.FieldOfView = S.FOV
    end)

    S.FreecamActive = true

    -- Show joystick if on mobile
    if JoyLayer and UIS.TouchEnabled and S.TouchControls then
        JoyLayer.Visible = true
    end
end

local function DisableFreecam()
    if not S.FreecamActive then return end
    if FC.Conn then FC.Conn:Disconnect(); FC.Conn = nil end

    if not UIS.TouchEnabled then
        UIS.MouseBehavior = Enum.MouseBehavior.Default
    end

    local cam = WS.CurrentCamera
    if cam then
        cam.CameraType  = FC.OrigType
        cam.FieldOfView = 70
    end

    local ch = LP.Character
    if ch then
        local h = ch:FindFirstChild("HumanoidRootPart")
        if h then h.Anchored = false end
    end

    FC.Vel  = Vector3.zero
    TI.MoveX = 0; TI.MoveY = 0; TI.MoveZ = 0
    TI.LookX = 0; TI.LookY = 0
    S.FreecamActive = false

    if JoyLayer then JoyLayer.Visible = false end
end

