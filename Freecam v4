--  PANEL OPEN / CLOSE  (does NOT touch freecam)
-- ═══════════════════════════════════════════
local function OpenPanel()
    Panel.Visible = true
    Panel.Size    = UDim2.new(0,PW,0,0)
    TS:Create(Panel,
        TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size = UDim2.new(0,PW,0,PH)}):Play()
    S.PanelOpen = true
end

local function ClosePanel()
    -- FREECAM KEEPS RUNNING
    TS:Create(Panel,
        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Size = UDim2.new(0,PW,0,0)}):Play()
    task.delay(0.2, function()
        Panel.Visible = false
        Panel.Size    = UDim2.new(0,PW,0,PH)
    end)
    S.PanelOpen = false
end

TapConnect(Toggle, function()
    if S.PanelOpen then ClosePanel() else OpenPanel() end
end)

