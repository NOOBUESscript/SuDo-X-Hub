-- ── Touch routing ──────────────────────────
local jTouchId  = nil
local jOrigin   = Vector2.zero
local lTouchId  = nil
local lLastPos  = Vector2.zero

local function InFrame(f, pos)
    local ap = f.AbsolutePosition; local as = f.AbsoluteSize
    return pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y
end

local function JoyUpdate(pos)
    local centre = JBase.AbsolutePosition + JBase.AbsoluteSize/2
    local delta  = pos - centre
    local mag    = delta.Magnitude
    local clamp  = mag > JOY_R and delta.Unit*JOY_R or delta
    JKnob.Position = UDim2.new(0.5,clamp.X-21,0.5,clamp.Y-21)
    if mag > 6 then
        local n = delta.Unit * math.min(mag/JOY_R,1)
        TI.MoveX = n.X; TI.MoveZ = n.Y
    else
        TI.MoveX = 0; TI.MoveZ = 0
    end
end

local function JoyReset()
    jTouchId = nil; TI.MoveX = 0; TI.MoveZ = 0
    JKnob.Position = UDim2.new(0.5,-21,0.5,-21)
end

UIS.TouchStarted:Connect(function(inp, gp)
    if gp or not S.FreecamActive then return end
    local pos = Vector2.new(inp.Position.X, inp.Position.Y)
    local sw  = SG.AbsoluteSize.X
    if jTouchId == nil and (InFrame(JBase,pos) or pos.X < sw*0.5) then
        jTouchId = inp; JoyUpdate(pos)
    elseif lTouchId == nil and (InFrame(LPad,pos) or pos.X >= sw*0.5) then
        lTouchId = inp; lLastPos = pos
    end
end)

UIS.TouchMoved:Connect(function(inp, gp)
    if gp or not S.FreecamActive then return end
    local pos = Vector2.new(inp.Position.X, inp.Position.Y)
    if jTouchId == inp then JoyUpdate(pos) end
    if lTouchId == inp then
        local d = pos - lLastPos
        TI.LookX = -d.X * LOOK_SENS
        TI.LookY = -d.Y * LOOK_SENS
        lLastPos = pos
    end
end)

UIS.TouchEnded:Connect(function(inp, gp)
    if gp then return end
    if jTouchId == inp then JoyReset() end
    if lTouchId == inp then lTouchId = nil end
end)

