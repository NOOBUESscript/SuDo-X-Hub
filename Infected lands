local function NewDrawing(type_, props)
    local d = Drawing.new(type_)
    for k, v in pairs(props or {}) do d[k] = v end
    return d
end

-- ── PLAYER ESP ──
local function CreatePlayerESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end

    local box = NewDrawing("Square", {
        Visible = false, Filled = false,
        Color = ESPConfig.PlayerBoxColor,
        Thickness = 1.5, Transparency = 1,
    })
    local boxFill = NewDrawing("Square", {
        Visible = false, Filled = true,
        Color = ESPConfig.PlayerFillColor,
        Thickness = 1, Transparency = ESPConfig.PlayerFillTrans,
    })
    local boxOutline = NewDrawing("Square", {
        Visible = false, Filled = false,
        Color = ESPConfig.PlayerOutlineColor,
        Thickness = 3, Transparency = 1,
    })
    local nameLabel = NewDrawing("Text", {
        Visible = false, Center = true,
        Color = ESPConfig.PlayerNameColor,
        Size = 13, Outline = true,
        OutlineColor = Color3.new(0,0,0),
        Font = Drawing.Fonts.UI,
    })
    local distLabel = NewDrawing("Text", {
        Visible = false, Center = true,
        Color = ESPConfig.PlayerDistColor,
        Size = 11, Outline = true,
        OutlineColor = Color3.new(0,0,0),
        Font = Drawing.Fonts.UI,
    })
    local healthBar = NewDrawing("Square", {
        Visible = false, Filled = true,
        Color = Color3.fromRGB(50, 200, 50),
        Thickness = 1, Transparency = 1,
    })
    local healthBg = NewDrawing("Square", {
        Visible = false, Filled = true,
        Color = Color3.fromRGB(30, 30, 30),
        Thickness = 1, Transparency = 1,
    })

    -- Highlight
    local highlight = Instance.new("SelectionBox")
    highlight.LineThickness = 0.05
    highlight.Color3 = ESPConfig.PlayerBoxColor
    highlight.SurfaceColor3 = ESPConfig.PlayerFillColor
    highlight.SurfaceTransparency = ESPConfig.PlayerFillTrans
    highlight.Parent = Camera

    ESPObjects[player] = {
        box = box, boxFill = boxFill, boxOutline = boxOutline,
        nameLabel = nameLabel, distLabel = distLabel,
        healthBar = healthBar, healthBg = healthBg,
        highlight = highlight,
    }
end

local function RemovePlayerESP(player)
    local obj = ESPObjects[player]
    if not obj then return end
    for _, d in pairs(obj) do
        if typeof(d) == "Instance" then
            d:Destroy()
        elseif type(d) == "userdata" and d.Remove then
            d:Remove()
        end
    end
    ESPObjects[player] = nil
end

local function UpdatePlayerESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local obj = ESPObjects[player]
        if not obj then continue end

        local enabled = ESPConfig.PlayerEnabled
        local char = GetCharacter(player)
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")

        if not enabled or not hrp or not hum or hum.Health <= 0 then
            for _, d in pairs(obj) do
                if typeof(d) == "Instance" then
                    if d:IsA("SelectionBox") then d.Adornee = nil end
                elseif type(d) == "userdata" and d.Visible ~= nil then
                    d.Visible = false
                end
            end
            continue
        end

        local dist = Distance(hrp.Position)
        if dist > ESPConfig.PlayerMaxDist then
            for _, d in pairs(obj) do
                if typeof(d) ~= "Instance" and type(d) == "userdata" and d.Visible ~= nil then
                    d.Visible = false
                end
            end
            continue
        end

        -- Highlight
        if ESPConfig.PlayerHighlight then
            obj.highlight.Adornee = char
            obj.highlight.Color3 = ESPConfig.PlayerBoxColor
            obj.highlight.SurfaceColor3 = ESPConfig.PlayerFillColor
            obj.highlight.SurfaceTransparency = ESPConfig.PlayerFillTrans
        else
            obj.highlight.Adornee = nil
        end

        -- 2D Box
        if ESPConfig.PlayerBox and head then
            local rootScreen, rootZ, rootOn = WorldToViewport(hrp.Position)
            if rootOn and rootZ > 0 then
                local headScreen = WorldToViewport(head.Position + Vector3.new(0, 0.7, 0))
                local scale = 1 / rootZ * 1000
                local boxW = scale * 2.5
                local boxH = (rootScreen.Y - headScreen.Y) * 1.15
                local boxX = rootScreen.X - boxW / 2
                local boxY = headScreen.Y - (boxH * 0.08)

                -- outline
                RoundedBox(obj.boxOutline, boxX - 1, boxY - 1, boxW + 2, boxH + 2, 3, Color3.new(0,0,0))
                -- fill
                if ESPConfig.PlayerBox then
                    RoundedBox(obj.boxFill, boxX, boxY, boxW, boxH, 1, ESPConfig.PlayerFillColor, ESPConfig.PlayerFillTrans)
                    RoundedBox(obj.box, boxX, boxY, boxW, boxH, 1.5, ESPConfig.PlayerBoxColor)
                end

                -- health bar
                local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local barH = boxH * hpRatio
                local barX = boxX - 6
                obj.healthBg.Visible   = true
                obj.healthBg.Position  = Vector2.new(barX, boxY)
                obj.healthBg.Size      = Vector2.new(4, boxH)
                obj.healthBg.Color     = Color3.fromRGB(30, 30, 30)
                obj.healthBar.Visible  = true
                obj.healthBar.Position = Vector2.new(barX, boxY + boxH - barH)
                obj.healthBar.Size     = Vector2.new(4, barH)
                local g = hpRatio
                obj.healthBar.Color = Color3.new(1 - g, g, 0)

                -- name
                obj.nameLabel.Visible  = ESPConfig.PlayerName
                obj.nameLabel.Text     = player.DisplayName
                obj.nameLabel.Color    = ESPConfig.PlayerNameColor
                obj.nameLabel.Position = Vector2.new(rootScreen.X, boxY - 16)

                -- distance
                obj.distLabel.Visible  = ESPConfig.PlayerDistance
                obj.distLabel.Text     = "[" .. dist .. "m]"
                obj.distLabel.Color    = ESPConfig.PlayerDistColor
                obj.distLabel.Position = Vector2.new(rootScreen.X, boxY + boxH + 2)
            else
                obj.box.Visible       = false
                obj.boxFill.Visible   = false
                obj.boxOutline.Visible = false
                obj.nameLabel.Visible  = false
                obj.distLabel.Visible  = false
                obj.healthBar.Visible  = false
                obj.healthBg.Visible   = false
            end
        else
            obj.box.Visible        = false
            obj.boxFill.Visible    = false
            obj.boxOutline.Visible = false
            obj.healthBar.Visible  = false
            obj.healthBg.Visible   = false
            -- still show name/dist without box
            if head then
                local screenPos, screenZ, onScreen = WorldToViewport(head.Position + Vector3.new(0, 0.7, 0))
                obj.nameLabel.Visible  = ESPConfig.PlayerName and onScreen and screenZ > 0
                obj.nameLabel.Text     = player.DisplayName
                obj.nameLabel.Position = screenPos
                obj.distLabel.Visible  = ESPConfig.PlayerDistance and onScreen and screenZ > 0
                obj.distLabel.Text     = "[" .. dist .. "m]"
                obj.distLabel.Position = screenPos + Vector2.new(0, 16)
            end
        end
    end
end

