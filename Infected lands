-- ── Survival loop ──
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum then
        -- Godmode
        if PlayerConfig.Godmode and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
        -- Speed/Jump persist across respawn
        if hum.WalkSpeed ~= PlayerConfig.WalkSpeed then
            hum.WalkSpeed = PlayerConfig.WalkSpeed
        end
        if hum.JumpPower ~= PlayerConfig.JumpPower then
            hum.JumpPower = PlayerConfig.JumpPower
        end
        -- No fall damage
        if PlayerConfig.NoFallDamage then
            hum.WalkSpeed = math.max(hum.WalkSpeed, PlayerConfig.WalkSpeed)
        end
        -- Anti knockback
        if PlayerConfig.AntiKnockback and hrp then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, hrp.Velocity.Y > 0 and hrp.Velocity.Y or 0, hrp.Velocity.Z)
        end
    end

    -- Noclip
    if PlayerConfig.Noclip and hrp then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Infinite Stamina / Hunger / Thirst via VitalsUI or playerData
    -- Try StarterGui VitalsUI root values
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local vitalsUI = playerGui:FindFirstChild("VitalsUI")
        if vitalsUI then
            local root = vitalsUI:FindFirstChild("Root")
            if root then
                -- Hunger
                if PlayerConfig.InfHunger then
                    local hungerVal = root:FindFirstChild("Hunger") or root:FindFirstChildWhichIsA("NumberValue")
                    if hungerVal and hungerVal:IsA("NumberValue") then hungerVal.Value = hungerVal.MaxValue or 100 end
                end
            end
        end
    end

    -- Try playerData in ReplicatedStorage
    local rs = game:GetService("ReplicatedStorage")
    local bytenetStorage = rs:FindFirstChild("BytenetStorage")
    if bytenetStorage then
        local playerData = bytenetStorage:FindFirstChild("playerData")
        if playerData then
            local myData = playerData:FindFirstChild(tostring(LocalPlayer.UserId))
            if myData then
                if PlayerConfig.InfStamina then
                    local stam = myData:FindFirstChild("Stamina") or myData:FindFirstChild("stamina")
                    if stam and stam:IsA("NumberValue") then stam.Value = 100 end
                end
                if PlayerConfig.InfHunger then
                    local hung = myData:FindFirstChild("Hunger") or myData:FindFirstChild("hunger")
                    if hung and hung:IsA("NumberValue") then hung.Value = 100 end
                end
                if PlayerConfig.InfThirst then
                    local thirst = myData:FindFirstChild("Thirst") or myData:FindFirstChild("thirst")
                    if thirst and thirst:IsA("NumberValue") then thirst.Value = 100 end
                end
            end
        end
    end
end)

