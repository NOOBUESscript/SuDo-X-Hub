-- ================================================================
-- UTILITY FUNCTIONS
-- ================================================================
local function GetCharacter(player)
    return player and player.Character
end

local function GetHRP(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHead(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("Head")
end

local function IsAlive(player)
    local char = GetCharacter(player)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function WorldToViewport(pos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), screenPos.Z, onScreen
end

local function Distance(pos)
    local hrp = GetHRP(LocalPlayer)
    if not hrp then return 0 end
    return math.floor((hrp.Position - pos).Magnitude)
end

local function RoundedBox(drawing, x, y, w, h, thickness, color, transparency)
    drawing.Visible    = true
    drawing.Position   = Vector2.new(x, y)
    drawing.Size       = Vector2.new(w, h)
    drawing.Thickness  = thickness
    drawing.Color      = color
    drawing.Transparency = transparency or 1
end

