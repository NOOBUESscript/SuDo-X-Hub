local LootCategories = {
    weapons  = {"baseballbatmetal","baseballbatwood","crowbar","machete","kitchenknife","militaryknife","specialknife","metalpipe","hammer","M14","AK 47","Desert Eagle","Famas","G17","G36","M16","M1911","M4","M9 Pistol","Makarov","Mosin Nagant","Remington 700","Remington 870","Scar","UZI","WD39"},
    medical  = {"bandage","bandagesdirty","firstaidkit","medkit","disinfectantspray","vitamins","repairkit"},
    food     = {"cerealboxfood","energybarfood","fundrinkfood","kentuckybeans","tunafood","waterbottlefood","oilmetaltin"},
    ammo     = {"pistolammobox","rifleammobox","shotgunammobox","sniperammobox"},
    backpacks= {"Blue Duffle Bag","Brown Duffle Bag","Expedition Backpack","Field Backpack","Green Duffle Bag","Military Backpack","Military Duffle Bag","National Guard Backpack","Red Duffle Bag","Tactical Backpack","White Duffle Bag","Improvised Backpack Green","Improvised Backpack Military","Improvised Backpack Orange"},
    keys     = {"Gun Store Keycard","Military Base Keycard","Louisville Police Station Keycard"},
}

local LootColors = {
    weapons  = Color3.fromRGB(255, 80,  80),
    medical  = Color3.fromRGB(80,  255, 120),
    food     = Color3.fromRGB(255, 200, 50),
    ammo     = Color3.fromRGB(255, 140, 0),
    backpacks= Color3.fromRGB(100, 200, 255),
    keys     = Color3.fromRGB(255, 255, 100),
    other    = Color3.fromRGB(200, 200, 200),
}

local function GetLootCategory(name)
    for cat, list in pairs(LootCategories) do
        for _, item in ipairs(list) do
            if item:lower() == name:lower() then return cat end
        end
    end
    return "other"
end

local function ShouldShowLoot(name)
    if ESPConfig.LootAll then return true end
    local cat = GetLootCategory(name)
    if cat == "weapons"   and ESPConfig.LootWeapons   then return true end
    if cat == "medical"   and ESPConfig.LootMedical   then return true end
    if cat == "food"      and ESPConfig.LootFood       then return true end
    if cat == "ammo"      and ESPConfig.LootAmmo       then return true end
    if cat == "backpacks" and ESPConfig.LootBackpacks  then return true end
    if cat == "keys"      and ESPConfig.LootKeys       then return true end
    return false
end

local function CreateLootESP(tool)
    if LootESP[tool] then return end
    if not tool:IsA("Tool") and not tool:IsA("Model") then return end
    -- Only loot on the ground (not in a player's backpack)
    if tool.Parent and tool.Parent:IsA("Model") and Players:GetPlayerFromCharacter(tool.Parent) then return end

    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if not handle then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 120, 0, 28)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = handle

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = tool.Name
    local cat = GetLootCategory(tool.Name)
    label.TextColor3 = LootColors[cat] or LootColors.other
    label.TextScaled = false
    label.TextSize = ESPConfig.LootTextSize
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0,0,0)
    label.Parent = billboard

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0, 14)
    distLabel.Position = UDim2.new(0, 0, 1, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = ""
    distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLabel.TextSize = 11
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextStrokeTransparency = 0
    distLabel.Parent = billboard

    LootESP[tool] = { billboard = billboard, label = label, distLabel = distLabel, handle = handle }
end

local function RemoveLootESP(tool)
    local obj = LootESP[tool]
    if not obj then return end
    obj.billboard:Destroy()
    LootESP[tool] = nil
end

local function UpdateLootESP()
    local myHRP = GetHRP(LocalPlayer)
    for tool, obj in pairs(LootESP) do
        if not tool or not tool.Parent then
            RemoveLootESP(tool)
            continue
        end
        -- hide if picked up by a player
        if tool.Parent and Players:GetPlayerFromCharacter(tool.Parent) then
            obj.billboard.Enabled = false
            continue
        end
        if not ESPConfig.LootEnabled or not ShouldShowLoot(tool.Name) then
            obj.billboard.Enabled = false
            continue
        end
        local handle = obj.handle
        if not handle or not handle.Parent then continue end
        local dist = myHRP and math.floor((myHRP.Position - handle.Position).Magnitude) or 999
        if dist > ESPConfig.LootMaxDist then
            obj.billboard.Enabled = false
            continue
        end
        obj.billboard.Enabled = true
        obj.distLabel.Text = dist .. "m"
        local cat = GetLootCategory(tool.Name)
        obj.label.TextColor3 = LootColors[cat] or LootColors.other
    end
end

-- Scan workspace for loot
local function ScanLoot()
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("Tool") or (v:IsA("Model") and v:FindFirstChild("Handle"))) then
            CreateLootESP(v)
        end
    end
end
ScanLoot()
workspace.DescendantAdded:Connect(function(v)
    if v:IsA("Tool") or (v:IsA("Model") and v:FindFirstChild("Handle")) then
        task.wait(0.1)
        CreateLootESP(v)
    end
end)
workspace.DescendantRemoving:Connect(function(v)
    if LootESP[v] then RemoveLootESP(v) end
end)

