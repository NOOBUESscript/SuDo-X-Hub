local AimbotConfig = {
    Enabled       = false,
    TargetZombies = true,
    TargetPlayers = false,
    FOV           = 120,
    Smoothness    = 0.1,
    SilentAim     = false,
    ShowFOVCircle = true,
    FOVColor      = Color3.fromRGB(255, 255, 255),
    HitPart       = "Head",
    AutoFire      = false,
    PredictMovement = false,
    WallCheck     = true,
}

-- FOV circle drawing
local FOVCircle = NewDrawing("Circle", {
    Visible = false, Filled = false,
    Thickness = 1.5, Color = AimbotConfig.FOVColor,
    Transparency = 1, NumSides = 64,
    Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2),
    Radius = AimbotConfig.FOV,
})

local function UpdateFOVCircle()
    FOVCircle.Visible = AimbotConfig.Enabled and AimbotConfig.ShowFOVCircle
    FOVCircle.Radius  = AimbotConfig.FOV
    FOVCircle.Color   = AimbotConfig.FOVColor
    local vp = Camera.ViewportSize
    FOVCircle.Position = Vector2.new(vp.X/2, vp.Y/2)
end

local function GetClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local closest, closestDist = nil, AimbotConfig.FOV

    -- Check zombies
    if AimbotConfig.TargetZombies then
        for zombie, _ in pairs(ZombieESP) do
            if not zombie or not zombie.Parent then continue end
            local hum = zombie:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local head = zombie:FindFirstChild("Head") or zombie:FindFirstChild("HumanoidRootPart")
            if not head then continue end

            -- wall check
            if AimbotConfig.WallCheck then
                local myHRP = GetHRP(LocalPlayer)
                if myHRP then
                    local ray = workspace:Raycast(myHRP.Position, head.Position - myHRP.Position,
                        RaycastParams.new())
                    if ray and not zombie:IsAncestorOf(ray.Instance) then continue end
                end
            end

            local screenPos, screenZ, onScreen = WorldToViewport(head.Position)
            if not onScreen or screenZ <= 0 then continue end
            local d = (center - screenPos).Magnitude
            if d < closestDist then
                closest = head
                closestDist = d
            end
        end
    end

    -- Check players
    if AimbotConfig.TargetPlayers then
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if not IsAlive(player) then continue end
            local part = AimbotConfig.HitPart == "Head" and GetHead(player) or GetHRP(player)
            if not part then continue end

            if AimbotConfig.WallCheck then
                local myHRP = GetHRP(LocalPlayer)
                if myHRP then
                    local ray = workspace:Raycast(myHRP.Position, part.Position - myHRP.Position, RaycastParams.new())
                    if ray and not (player.Character and player.Character:IsAncestorOf(ray.Instance)) then continue end
                end
            end

            local screenPos, screenZ, onScreen = WorldToViewport(part.Position)
            if not onScreen or screenZ <= 0 then continue end
            local d = (center - screenPos).Magnitude
            if d < closestDist then
                closest = part
                closestDist = d
            end
        end
    end

    return closest
end

local function AimbotStep()
    if not AimbotConfig.Enabled then AimbotTarget = nil return end
    UpdateFOVCircle()
    local target = GetClosestTarget()
    AimbotTarget = target
    if not target then return end

    if AimbotConfig.SilentAim then
        -- silent aim: handled in custom raycast hook (executor-level)
        -- This is a placeholder for executors that support hookfunction
    else
        -- standard camera aim
        local targetPos = target.Position
        if AimbotConfig.PredictMovement and target.Velocity ~= nil then
            local vel = target.Velocity
            local dist = Distance(targetPos)
            local travelTime = dist / 600 -- rough bullet speed
            targetPos = targetPos + vel * travelTime
        end
        local lookAt = CFrame.lookAt(Camera.CFrame.Position, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(lookAt, AimbotConfig.Smoothness)
    end
end

