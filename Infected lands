local ZombieFolder = nil
local function FindZombieFolder()
    -- Zombies are typically in workspace under a folder
    local ws = workspace
    for _, v in ipairs(ws:GetDescendants()) do
        if v:IsA("Folder") and (v.Name:lower():find("zombie") or v.Name == "Zombies" or v.Name == "NPC") then
            return v
        end
    end
    return ws
end

local function IsZombie(model)
    if not model:IsA("Model") then return false end
    local name = model.Name:lower()
    return name:find("zombie") or name:find("infected") or name:find("walker") or name:find("runner") or name:find("crawler")
end

local function CreateZombieESP(zombie)
    if ZombieESP[zombie] then return end
    if not zombie:IsA("Model") then return end

    local highlight = Instance.new("SelectionBox")
    highlight.LineThickness = 0.05
    highlight.Color3 = ESPConfig.ZombieColor
    highlight.SurfaceColor3 = ESPConfig.ZombieFillColor
    highlight.SurfaceTransparency = ESPConfig.ZombieFillTrans
    highlight.Adornee = zombie
    highlight.Parent = Camera

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.Parent = zombie:FindFirstChild("HumanoidRootPart") or zombie.PrimaryPart or zombie

    local nameL = Instance.new("TextLabel")
    nameL.Size = UDim2.new(1, 0, 0.5, 0)
    nameL.BackgroundTransparency = 1
    nameL.Text = zombie.Name
    nameL.TextColor3 = ESPConfig.ZombieColor
    nameL.TextScaled = true
    nameL.Font = Enum.Font.GothamBold
    nameL.Parent = billboard

    local distL = Instance.new("TextLabel")
    distL.Size = UDim2.new(1, 0, 0.5, 0)
    distL.Position = UDim2.new(0, 0, 0.5, 0)
    distL.BackgroundTransparency = 1
    distL.Text = "0m"
    distL.TextColor3 = Color3.fromRGB(255, 215, 0)
    distL.TextScaled = true
    distL.Font = Enum.Font.Gotham
    distL.Parent = billboard

    ZombieESP[zombie] = { highlight = highlight, billboard = billboard, nameL = nameL, distL = distL }
end

local function RemoveZombieESP(zombie)
    local obj = ZombieESP[zombie]
    if not obj then return end
    obj.highlight:Destroy()
    obj.billboard:Destroy()
    ZombieESP[zombie] = nil
end

local function UpdateZombieESP()
    if not ESPConfig.ZombieEnabled then
        for zombie, obj in pairs(ZombieESP) do
            obj.highlight.Adornee = nil
            obj.billboard.Enabled = false
        end
        return
    end
    local myHRP = GetHRP(LocalPlayer)
    for zombie, obj in pairs(ZombieESP) do
        if not zombie or not zombie.Parent then
            RemoveZombieESP(zombie)
            continue
        end
        local hum = zombie:FindFirstChildOfClass("Humanoid")
        local hrp = zombie:FindFirstChild("HumanoidRootPart") or zombie.PrimaryPart
        if not hrp or (hum and hum.Health <= 0) then
            obj.highlight.Adornee = nil
            obj.billboard.Enabled = false
            continue
        end
        local dist = myHRP and math.floor((myHRP.Position - hrp.Position).Magnitude) or 999
        if dist > ESPConfig.ZombieMaxDist then
            obj.highlight.Adornee = nil
            obj.billboard.Enabled = false
            continue
        end
        if ESPConfig.ZombieHighlight then
            obj.highlight.Adornee = zombie
            obj.highlight.Color3 = ESPConfig.ZombieColor
            obj.highlight.SurfaceColor3 = ESPConfig.ZombieFillColor
            obj.highlight.SurfaceTransparency = ESPConfig.ZombieFillTrans
        else
            obj.highlight.Adornee = nil
        end
        obj.billboard.Enabled = ESPConfig.ZombieName or ESPConfig.ZombieDistance
        obj.nameL.Visible = ESPConfig.ZombieName
        obj.distL.Visible = ESPConfig.ZombieDistance
        obj.distL.Text = dist .. "m"
    end
end

