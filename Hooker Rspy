-- KEY FIX: Use ONE global InputChanged
-- instead of multiple per-frame checks
table.insert(connections, UserInputService.InputChanged:Connect(function(inp)
    local vp = workspace.CurrentCamera.ViewportSize
    if inp == pDragIn and pDrag then
        local d = inp.Position - pDragSt
        if d.Magnitude > 5 then pWasDrag = true end
        Pill.Position = UDim2.new(
            0, math.clamp(pDragPos.X.Offset + d.X, 0, vp.X - 90),
            0, math.clamp(pDragPos.Y.Offset + d.Y, 0, vp.Y - 26)
        )
    end
    if inp == mDragIn and mDrag then
        local d = inp.Position - mDragSt
        Main.Position = UDim2.new(
            0, math.clamp(mDragPos.X.Offset + d.X, 0, vp.X - 350),
            0, math.clamp(mDragPos.Y.Offset + d.Y, 0, vp.Y - 220)
        )
    end
end))

