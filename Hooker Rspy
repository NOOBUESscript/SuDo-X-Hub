-- ============================================================
-- QUEUE (2 per frame max)
-- ============================================================
local qConn = RunService.Heartbeat:Connect(function()
    if not pendingEnabled then return end
    local done = 0
    while #pending > 0 and done < 2 do
        local fn = table.remove(pending, 1)
        if type(fn) == "function" then pcall(fn) end
        done += 1
    end
    if #pending > 500 then
        local keep = {}
        for i = 1, 100 do keep[i] = pending[i] end
        pending = keep
    end
end)

table.insert(connections, qConn)

local function enqueue(fn)
    if type(fn) == "function" then
        table.insert(pending, fn)
    end
end

