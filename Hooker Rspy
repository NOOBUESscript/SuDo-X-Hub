-- ============================================================
-- UPDATE BADGE
-- ============================================================
local function updateBadge(key)
    local d = remoteData[key]
    if not d or not d.Frame then return end
    local badge = d.Frame:FindFirstChild("Badge")
    if not badge then return end
    local c = d.Count
    if c > 1 then
        badge.Visible = true
        local t = badge:FindFirstChild("T")
        if t then
            t.Text = c >= 1000
                and string.format("%.1fk", c/1000)
                or tostring(c)
        end
        badge.BackgroundColor3 = c > 100
            and Color3.fromRGB(220, 50, 50)
            or c > 50
            and Color3.fromRGB(230, 126, 34)
            or c > 10
            and Color3.fromRGB(200, 160, 20)
            or Color3.fromRGB(99, 86, 245)
    else
        badge.Visible = false
    end
end

-- ============================================================
-- HANDLE REMOTE
-- ============================================================
local function handleRemote(remote, args, rtype)
    if not spyOn or not remote then return false end
    local name = "?"
    pcall(function() name = remote.Name end)
    if blacklist[remote] or blacklist[name] then return false end
    local blocked = (blocklist[remote] or blocklist[name]) and true or false

    if autoblock then
        local h = history[remote]
        if not h then
            h = {n = 0, t = tick()}
            history[remote] = h
        end
        local now = tick()
        if now - h.t < 1 then
            h.n += 1
            if h.n > 25 then
                blacklist[remote] = true
                return false
            end
        else h.n = 0 h.t = now end
    end

    local key = tostring(remote)

    enqueue(function()
        if not remoteData[key] then
            remoteData[key] = {
                Remote = remote,
                Name = name,
                Type = rtype,
                Count = 0,
                Script = ""
            }
            remoteData[key].Frame = createEntry(name, rtype, key)
            table.insert(logs, remoteData[key])
        end
        local d = remoteData[key]
        d.Count += 1
        if d.Count == 1 or d.Count % 5 == 0 then
            local s = genScript(remote, args)
            if blocked then s = "-- BLOCKED\n\n"..s end
            d.Script = s
            if selected == key then setCode(s) end
        end
        updateBadge(key)
        if d.Frame then
            d.Frame.LayoutOrder = -d.Count
        end
        LogsScroll.CanvasSize = UDim2.new(
            0, 0, 0, LogsLL.AbsoluteContentSize.Y + 4
        )
        local max = _G.SIMPLESPYCONFIG_MaxRemotes or 150
        if #logs > max then
            local old = table.remove(logs, 1)
            if old then
                if old.Frame then old.Frame:Destroy() end
                if old.Remote then
                    remoteData[tostring(old.Remote)] = nil
                end
            end
        end
    end)

    return blocked
end

-- ============================================================
-- HOOKS
-- ============================================================
local ncHook = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if typeof(self) == "Instance"
    and (method == "FireServer" or method == "InvokeServer") then
        local ok, isR = pcall(function()
            return self:IsA("RemoteEvent") or self:IsA("RemoteFunction")
        end)
        if ok and isR then
            local args = {...}
            local rtype = method == "FireServer" and "Event" or "Function"
            local blocked = handleRemote(self, args, rtype)
            if blocked then
                return method == "InvokeServer" and nil or nil
            end
            return original(self, table.unpack(args))
        end
    end
    return original(self, ...)
end, originalNamecall)

local fireHook = newcclosure(function(self, ...)
    if typeof(self) ~= "Instance" then return origFire(self, ...) end
    local args = {...}
    local blocked = handleRemote(self, args, "Event")
    if blocked then return end
    return origFire(self, table.unpack(args))
end, origFire)

local invokeHook = newcclosure(function(self, ...)
    if typeof(self) ~= "Instance" then return origInvoke(self, ...) end
    local args = {...}
    local blocked = handleRemote(self, args, "Function")
    if blocked then return nil end
    return origInvoke(self, table.unpack(args))
end, origInvoke)

-- ============================================================
-- APPLY / REMOVE HOOKS
-- ============================================================
local function applyHooks()
    if hookmetamethod then
        local ok, r = pcall(function()
            return hookmetamethod(game, "__namecall", ncHook)
        end)
        if ok and r then
            original = r
            hookedNC = true
        end
    end
    if not hookedNC then
        pcall(function()
            setreadonly(gmt, false)
            rawset(gmt, "__namecall", ncHook)
            setreadonly(gmt, true)
            hookedNC = true
        end)
    end
    pcall(function()
        hookfunction(_re.FireServer, fireHook)
        hookfunction(_rf.InvokeServer, invokeHook)
    end)
    spyOn = true
    StatDot.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
    PillDot.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
    TitleLbl.Text = "SimpleSpy • ON"
end

local function removeHooks()
    if hookmetamethod and original then
        pcall(function() hookmetamethod(game, "__namecall", original) end)
    elseif hookedNC then
        pcall(function()
            setreadonly(gmt, false)
            rawset(gmt, "__namecall", originalNamecall)
            setreadonly(gmt, true)
        end)
    end
    pcall(function()
        if origFire then hookfunction(_re.FireServer, origFire) end
        if origInvoke then hookfunction(_rf.InvokeServer, origInvoke) end
    end)
    hookedNC = false
    spyOn = false
    StatDot.BackgroundColor3 = Color3.fromRGB(210, 50, 50)
    PillDot.BackgroundColor3 = Color3.fromRGB(210, 50, 50)
    TitleLbl.Text = "SimpleSpy • OFF"
end

-- ============================================================
-- SHUTDOWN
-- ============================================================
local function shutdown()
    pendingEnabled = false
    pending = {}
    removeHooks()
    for _, c in pairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    pcall(function() ScreenGui:Destroy() end)
    _G.SimpleSpyExecuted = false
    _G.SimpleSpyShutdown = nil
end

