local function openGui()
    guiOpen = true
    Main.Visible = true
    local vp = workspace.CurrentCamera.ViewportSize
    local px = Pill.AbsolutePosition.X
    local py = Pill.AbsolutePosition.Y
    Main.Size = UDim2.new(0, 10, 0, 10)
    Main.Position = UDim2.new(0, px + 45, 0, py + 13)
    local tx = math.clamp(px - 130, 5, vp.X - 355)
    local ty = math.clamp(py + 32, 5, vp.Y - 225)
    TweenService:Create(Main,
        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 350, 0, 220),
        Position = UDim2.new(0, tx, 0, ty)
    }):Play()
end

local function closeGui()
    guiOpen = false
    local px = Pill.AbsolutePosition.X
    local py = Pill.AbsolutePosition.Y
    TweenService:Create(Main,
        TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(0, px + 45, 0, py + 13)
    }):Play()
    task.delay(0.25, function()
        if not guiOpen then Main.Visible = false end
    end)
end

