local function setCode(code)
    currentCode = code or ""
    CodeText.Text = currentCode
    local n, s = 0, ""
    for _ in (currentCode .. "\n"):gmatch("[^\n]*\n") do
        n += 1
        s = s .. n .. "\n"
    end
    LineNums.Text = s
    task.defer(function()
        CodeScroll.CanvasSize = UDim2.new(
            0, 0, 0, CodeText.AbsoluteSize.Y + 12
        )
    end)
end

-- ============================================================
-- VALUE TO STRING
-- ============================================================
local function v2s(v, d)
    d = d or 0
    if d > 2 then return "..." end
    local ok, r = pcall(function()
        local t = typeof(v)
        if t == "nil" then return "nil"
        elseif t == "boolean" or t == "number" then
            return tostring(v)
        elseif t == "string" then
            return string.format("%q", v)
        elseif t == "Instance" then
            local p = "nil"
            pcall(function() p = "game."..v:GetFullName() end)
            return p
        elseif t == "Vector3" then
            return string.format("Vector3.new(%g,%g,%g)", v.X, v.Y, v.Z)
        elseif t == "Vector2" then
            return string.format("Vector2.new(%g,%g)", v.X, v.Y)
        elseif t == "CFrame" then
            return string.format("CFrame.new(%g,%g,%g)", v.X, v.Y, v.Z)
        elseif t == "Color3" then
            return string.format("Color3.fromRGB(%d,%d,%d)",
                math.floor(v.R*255), math.floor(v.G*255), math.floor(v.B*255))
        elseif t == "UDim2" then
            return string.format("UDim2.new(%g,%g,%g,%g)",
                v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
        elseif t == "EnumItem" then return tostring(v)
        elseif t == "BrickColor" then
            return string.format("BrickColor.new(%q)", tostring(v))
        elseif t == "table" then
            local parts, c = {}, 0
            for k2, v2 in pairs(v) do
                c += 1
                if c > 12 then
                    table.insert(parts, "    -- ...")
                    break
                end
                local ks = type(k2) == "string"
                    and k2:match("^[%a_][%w_]*$")
                    and k2
                    or "["..v2s(k2, d+1).."]"
                table.insert(parts, "    "..ks.." = "..v2s(v2, d+1))
            end
            return #parts == 0 and "{}"
                or "{\n"..table.concat(parts, ",\n").."\n}"
        else return "nil --[["..t.."]]" end
    end)
    return ok and r or "nil"
end

-- ============================================================
-- GEN SCRIPT
-- ============================================================
local function genScript(remote, args)
    local out = {
        "-- SimpleSpy v4.2",
        "-- " .. (remote and remote.Name or "?"),
        ""
    }
    local path = "nil"
    pcall(function() path = "game."..remote:GetFullName() end)
    local method = "FireServer"
    pcall(function()
        if remote:IsA("RemoteFunction") then method = "InvokeServer" end
    end)
    if args and #args > 0 then
        table.insert(out, "local args = {")
        for i, v in ipairs(args) do
            if i > 20 then table.insert(out, "    -- ...") break end
            table.insert(out, "    ["..i.."] = "..v2s(v)..",")
        end
        table.insert(out, "}")
        table.insert(out, "")
        table.insert(out, path..":"..method.."(table.unpack(args))")
    else
        table.insert(out, path..":"..method.."()")
    end
    return table.concat(out, "\n")
end

