-- // Mobile Screen Swiping // --
UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if gameProcessed then return end 
	
	if freecamEnabled and not cameraLocked then
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Delta
			xAngle = xAngle - delta.X * 0.005
			yAngle = math.clamp(yAngle - delta.Y * 0.005, -math.pi/2, math.pi/2)
		end
	end
end)

-- // Main Camera Loop // --
RunService.RenderStepped:Connect(function(dt)
	if freecamEnabled then
		if not cameraLocked then
			local moveDir = Vector3.new(
				(touchMove.R and 1 or 0) - (touchMove.L and 1 or 0),
				(touchMove.U and 1 or 0) - (touchMove.D and 1 or 0),
				(touchMove.B and 1 or 0) - (touchMove.F and 1 or 0)
			)
			
			camCFrame = CFrame.new(camCFrame.Position) 
				* CFrame.Angles(0, xAngle, 0) 
				* CFrame.Angles(yAngle, 0, 0)
			
			camCFrame = camCFrame + camCFrame:VectorToWorldSpace(moveDir * speed * dt)
		end
		camera.CFrame = camCFrame
	end
end)
