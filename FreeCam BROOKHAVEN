local function createDirBtn(icon, pos, moveKey)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 48, 0, 48)
	btn.Position = pos
	btn.BackgroundColor3 = Theme.Surface
	btn.TextColor3 = Theme.Text
	btn.Text = icon
	btn.TextSize = 22
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = false
	btn.Parent = DPadFrame
	
	-- Make it perfectly circular
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Color = Theme.Outline
	stroke.Thickness = 1
	
	-- Touch hold logic + smooth animations
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			touchMove[moveKey] = true
			tween(btn, {BackgroundColor3 = Theme.Highlight, Size = UDim2.new(0, 42, 0, 42), Position = pos + UDim2.new(0, 3, 0, 3)}, 0.1)
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			touchMove[moveKey] = false
			tween(btn, {BackgroundColor3 = Theme.Surface, Size = UDim2.new(0, 48, 0, 48), Position = pos}, 0.1)
		end
	end)
end

