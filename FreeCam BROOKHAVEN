ToggleCamBtn.MouseButton1Click:Connect(function()
	freecamEnabled = not freecamEnabled
	if freecamEnabled then
		tween(ToggleCamBtn, {BackgroundColor3 = Theme.AccentGreen}, 0.3)
		tween(ToggleStroke, {Color = Theme.AccentGreen}, 0.3)
		
		camCFrame = camera.CFrame
		local look = camCFrame.LookVector
		xAngle = math.atan2(-look.X, -look.Z)
		yAngle = math.asin(look.Y)
		camera.CameraType = Enum.CameraType.Scriptable
		
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			player.Character.HumanoidRootPart.Anchored = true
		end
	else
		tween(ToggleCamBtn, {BackgroundColor3 = Theme.Surface}, 0.3)
		tween(ToggleStroke, {Color = Theme.Outline}, 0.3)
		camera.CameraType = Enum.CameraType.Custom
		
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			player.Character.HumanoidRootPart.Anchored = false
		end
	end
end)

